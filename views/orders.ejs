<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Đơn hàng của tôi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/navbar') %>
  <div class="container" style="max-width: 900px;">
    <h4 class="mb-3">Đơn hàng của tôi</h4>
    <% if (orders.length === 0) { %>
      <div class="alert alert-secondary">Bạn chưa có đơn hàng nào. <a href="/">Mua sắm ngay</a></div>
    <% } else { %>
      <div class="table-responsive card shadow-sm">
        <table class="table table-hover align-middle mb-0">
          <thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Thanh toán</th><th class="text-end">Tổng tiền</th></tr></thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td><a href="/orders/<%= o.id %>"><%= o.order_code %></a></td>
                <td><%= new Date(o.created_at).toLocaleString('vi-VN') %></td>
                <td><%= paymentMethod[o.method] || '' %> · <small class="text-muted"><%= paymentStatus[o.pay_status] || '' %></small></td>
                <td class="text-end text-danger fw-bold"><%= vnd(o.total_amount) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>