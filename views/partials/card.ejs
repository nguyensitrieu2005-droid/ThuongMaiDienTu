<div class="col-6 col-md-4 col-lg-3">
  <div class="card h-100 shadow-sm">
    <% if (p.image_url) { %>
      <img src="<%= p.image_url %>" alt="<%= p.name %>" class="card-img-top"
           style="aspect-ratio: 4/3; object-fit: cover;" loading="lazy">
    <% } else { %>
            <div class="d-flex align-items-center justify-content-center text-white fw-bold <%= placeClass(p.id) %>"
           style="aspect-ratio: 4/3; font-size: 3rem;">
        <%= p.name.charAt(0).toUpperCase() %>
      </div>
    <% } %>
    <div class="card-body d-flex flex-column">
      <h6 class="card-title mb-1">
        <a href="/product/<%= p.id %>" class="text-dark text-decoration-none stretched-link"><%= p.name %></a>
      </h6>
      <p class="text-danger fw-bold mb-1"><%= p.price ? vnd(p.price) : 'Liên hệ' %></p>
      <div class="small">
        <% if (Number(p.review_count) > 0) { %>
          <span class="text-warning"><%= stars(p.avg_rating) %></span>
          <span class="text-muted"><%= p.avg_rating %> (<%= p.review_count %>)</span>
        <% } else { %>
          <span class="text-muted">Chưa có đánh giá</span>
        <% } %>
      </div>
      <div class="small text-muted mt-auto pt-2">
        <%= p.shop_name %><% if (Number(p.sold) > 0) { %> · Đã bán <%= p.sold %><% } %>
      </div>
    </div>
  </div>
</div>