<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Đặt hàng</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/navbar') %>
  <div class="container" style="max-width: 1000px;">
    <h4 class="mb-3">Đặt hàng</h4>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <form method="POST" action="/checkout">
      <div class="row g-4">
        <div class="col-lg-7">
          <div class="card shadow-sm mb-3">
            <div class="card-body">
              <h6>Địa chỉ giao hàng</h6>
              <% addresses.forEach((a, i) => { %>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="radio" name="address_id" id="a<%= a.id %>"
                         value="<%= a.id %>" <%= (form.address_id ? form.address_id == a.id : i === 0) ? 'checked' : '' %>>
                  <label class="form-check-label" for="a<%= a.id %>">
                    <strong><%= a.recipient_name %></strong> · <%= a.phone %><br>
                    <small class="text-muted"><%= a.street %>, <%= a.ward %>, <%= a.district %>, <%= a.province %></small>
                  </label>
                </div>
              <% }) %>

              <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="address_id" id="a-new" value="new"
                       <%= (addresses.length === 0 || form.address_id === 'new') ? 'checked' : '' %>>
                <label class="form-check-label" for="a-new">Dùng địa chỉ mới</label>
              </div>
              <div class="row g-2 ms-1">
                <div class="col-md-6"><input name="recipient_name" class="form-control" placeholder="Người nhận" value="<%= form.recipient_name || '' %>"></div>
                <div class="col-md-6"><input name="phone" class="form-control" placeholder="Số điện thoại" value="<%= form.phone || '' %>"></div>
                <div class="col-md-4"><input name="province" class="form-control" placeholder="Tỉnh/Thành phố" value="<%= form.province || '' %>"></div>
                <div class="col-md-4"><input name="district" class="form-control" placeholder="Quận/Huyện" value="<%= form.district || '' %>"></div>
                <div class="col-md-4"><input name="ward" class="form-control" placeholder="Phường/Xã" value="<%= form.ward || '' %>"></div>
                <div class="col-12"><input name="street" class="form-control" placeholder="Số nhà, tên đường" value="<%= form.street || '' %>"></div>
              </div>
            </div>
          </div>

          <div class="card shadow-sm">
            <div class="card-body">
              <h6>Phương thức thanh toán</h6>
              <% Object.entries(methods).forEach(([key, label], i) => { %>
                <div class="form-check mb-1">
                  <input class="form-check-input" type="radio" name="payment_method" id="m-<%= key %>"
                         value="<%= key %>" <%= (form.payment_method ? form.payment_method === key : i === 0) ? 'checked' : '' %>>
                  <label class="form-check-label" for="m-<%= key %>"><%= label %></label>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card shadow-sm">
            <div class="card-body">
              <h6>Đơn hàng của bạn</h6>
              <% groups.forEach(g => { %>
                <div class="border-top pt-2 mt-2">
                  <div class="fw-semibold small">Shop: <%= g.shop_name %></div>
                  <% g.items.forEach(i => { %>
                    <div class="d-flex justify-content-between small">
                      <span><%= i.name %> × <%= i.quantity %></span>
                      <span><%= vnd(i.line_total) %></span>
                    </div>
                  <% }) %>
                </div>
              <% }) %>
              <hr>
              <div class="d-flex justify-content-between"><span>Tạm tính</span><span><%= vnd(subtotal) %></span></div>
              <div class="d-flex justify-content-between"><span>Phí vận chuyển (<%= groups.length %> shop)</span><span><%= vnd(shippingFee) %></span></div>
              <div class="d-flex justify-content-between fs-5 mt-2">
                <strong>Tổng cộng</strong><strong class="text-danger"><%= vnd(total) %></strong>
              </div>
              <button class="btn btn-primary w-100 mt-3">Xác nhận đặt hàng</button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</body>
</html>