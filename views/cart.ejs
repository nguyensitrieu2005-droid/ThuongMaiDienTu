<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Giỏ hàng</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/navbar') %>
  <div class="container" style="max-width: 900px;">
    <h4 class="mb-3">Giỏ hàng của bạn</h4>

    <% if (groups.length === 0) { %>
      <div class="alert alert-secondary">Giỏ hàng đang trống. <a href="/">Tiếp tục mua sắm</a></div>
    <% } %>

    <% groups.forEach(g => { %>
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">Shop: <%= g.shop_name %></div>
        <ul class="list-group list-group-flush">
          <% g.items.forEach(i => { %>
            <li class="list-group-item">
              <div class="row align-items-center g-2">
                <div class="col-md-5">
                  <a href="/product/<%= i.product_id %>" class="text-decoration-none text-dark fw-semibold"><%= i.name %></a>
                  <div class="small text-muted"><%= Object.values(i.attributes || {}).join(' / ') || i.sku %></div>
                </div>
                <div class="col-md-2 text-danger"><%= vnd(i.price) %></div>
                <div class="col-md-3">
                  <form method="POST" action="/cart/update" class="d-flex gap-1">
                    <input type="hidden" name="item_id" value="<%= i.id %>">
                    <input type="number" name="quantity" value="<%= i.quantity %>" min="0" max="<%= i.stock_quantity %>" class="form-control form-control-sm" style="width: 70px;">
                    <button class="btn btn-sm btn-outline-secondary">Cập nhật</button>
                  </form>
                </div>
                <div class="col-md-2 d-flex justify-content-between align-items-center">
                  <strong><%= vnd(i.line_total) %></strong>
                  <form method="POST" action="/cart/remove" class="m-0">
                    <input type="hidden" name="item_id" value="<%= i.id %>">
                    <button class="btn btn-sm btn-outline-danger" title="Xóa">&times;</button>
                  </form>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
        <div class="card-footer bg-white text-end">
          Tạm tính shop này: <strong><%= vnd(g.subtotal) %></strong>
        </div>
      </div>
    <% }) %>

   <% if (groups.length > 0) { %>
  <div class="d-flex justify-content-end align-items-center gap-3 mb-4">
    <span class="fs-5">Tổng cộng: <strong class="text-danger"><%= vnd(total) %></strong></span>
    <a href="/checkout" class="btn btn-primary">Đặt hàng</a>
  </div>
<% } %>
  </div>
</body>
</html>