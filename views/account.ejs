<%- include('partials/head', { title: 'Tài khoản của tôi' }) %>
<div class="container" style="max-width: 900px;">
  <h4 class="mb-3">Tài khoản của tôi</h4>
  <% if (ok) { %><div class="alert alert-success py-2"><%= ok %></div><% } %>
  <% if (err) { %><div class="alert alert-danger py-2"><%= err %></div><% } %>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <div class="card shadow-sm h-100"><div class="card-body">
        <h6>Thông tin cá nhân</h6>
        <form method="POST" action="/account/profile">
          <div class="mb-2"><label class="form-label small">Email</label>
            <input class="form-control form-control-sm" value="<%= me.email %>" disabled></div>
          <div class="mb-2"><label class="form-label small">Họ và tên</label>
            <input name="full_name" class="form-control form-control-sm" value="<%= me.full_name %>" required></div>
          <div class="mb-3"><label class="form-label small">Số điện thoại</label>
            <input name="phone" class="form-control form-control-sm" value="<%= me.phone || '' %>"></div>
          <button class="btn btn-sm btn-primary">Lưu thay đổi</button>
        </form>
      </div></div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm h-100"><div class="card-body">
        <h6>Đổi mật khẩu</h6>
        <form method="POST" action="/account/password">
          <div class="mb-2"><label class="form-label small">Mật khẩu hiện tại</label>
            <input type="password" name="old_password" class="form-control form-control-sm" required></div>
          <div class="mb-2"><label class="form-label small">Mật khẩu mới</label>
            <input type="password" name="new_password" minlength="6" class="form-control form-control-sm" required></div>
          <div class="mb-3"><label class="form-label small">Nhập lại mật khẩu mới</label>
            <input type="password" name="confirm" class="form-control form-control-sm" required></div>
          <button class="btn btn-sm btn-primary">Đổi mật khẩu</button>
        </form>
      </div></div>
    </div>
  </div>

  <div class="card shadow-sm mb-5"><div class="card-body">
    <h6>Sổ địa chỉ</h6>
    <% if (!addresses.length) { %><p class="text-muted">Bạn chưa lưu địa chỉ nào.</p><% } %>
    <% addresses.forEach(a => { %>
      <div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-start gap-2">
        <div>
          <strong><%= a.recipient_name %></strong> · <%= a.phone %>
          <% if (a.is_default) { %><span class="badge text-bg-primary ms-1">Mặc định</span><% } %><br>
          <small class="text-muted"><%= a.street %>, <%= a.ward %>, <%= a.district %>, <%= a.province %></small>
        </div>
        <div class="d-flex gap-1">
          <% if (!a.is_default) { %>
            <form method="POST" action="/account/addresses/<%= a.id %>/default" class="m-0">
              <button class="btn btn-sm btn-outline-primary">Đặt mặc định</button></form>
          <% } %>
          <form method="POST" action="/account/addresses/<%= a.id %>/delete" class="m-0" onsubmit="return confirm('Xóa địa chỉ này?')">
            <button class="btn btn-sm btn-outline-danger">Xóa</button></form>
        </div>
      </div>
    <% }) %>

    <details class="mt-3">
      <summary class="btn btn-sm btn-outline-secondary">+ Thêm địa chỉ mới</summary>
      <form method="POST" action="/account/addresses" class="row g-2 mt-2">
        <div class="col-md-6"><input name="recipient_name" class="form-control form-control-sm" placeholder="Người nhận" required></div>
        <div class="col-md-6"><input name="phone" class="form-control form-control-sm" placeholder="Số điện thoại" required></div>
        <div class="col-md-4"><input name="province" class="form-control form-control-sm" placeholder="Tỉnh/Thành phố" required></div>
        <div class="col-md-4"><input name="district" class="form-control form-control-sm" placeholder="Quận/Huyện" required></div>
        <div class="col-md-4"><input name="ward" class="form-control form-control-sm" placeholder="Phường/Xã" required></div>
        <div class="col-12"><input name="street" class="form-control form-control-sm" placeholder="Số nhà, tên đường" required></div>
        <div class="col-12 form-check ms-1">
          <input class="form-check-input" type="checkbox" name="is_default" value="1" id="isDef">
          <label class="form-check-label small" for="isDef">Đặt làm địa chỉ mặc định</label>
        </div>
        <div class="col-12"><button class="btn btn-sm btn-primary">Lưu địa chỉ</button></div>
      </form>
    </details>
  </div></div>
</div>
<%- include('partials/foot') %>